# Copy to .env.local and fill in. Never commit real secrets.
# DATABASE_URL lives in .env (read by the Prisma CLI too); the rest go in
# .env.local. Both files are gitignored.

# Public base URL of the site (used for metadata / absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection (matches docker-compose.yml). Keep this in .env.
# On Vercel this is the POOLED connection string (auto-injected by the
# Vercel Postgres integration).
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

# Direct (non-pooled) Postgres URL — used only by `prisma migrate`. Locally it
# equals DATABASE_URL; on Vercel set it to the *_URL_NON_POOLING value.
DIRECT_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

# Session signing key — generate with: openssl rand -base64 32
SESSION_SECRET=

# Admin login (single owner). Generate the hash with:
#   npm run hash-password -- "your-password"
# In local .env files, escape every `$` in the hash as `\$` (dotenv-expand).
# In the Vercel dashboard, paste the hash RAW — no backslashes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ── Production-only (Vercel). Leave blank locally — the app falls back to
# ── local disk for uploads and an in-memory login rate limiter.

# Vercel Blob — image storage (auto-injected by the Blob integration).
BLOB_READ_WRITE_TOKEN=

# Upstash Redis — shared login rate limiter (auto-injected by the integration).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
