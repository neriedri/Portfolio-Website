// Prisma schema for the portfolio database.
// Translatable fields are stored as scalar he/en columns and assembled into the
// app's `{ he, en }` shape by src/lib/mappers.ts, so src/types/project.ts and
// all UI components stay unchanged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (PgBouncer) used at runtime by serverless functions.
  url      = env("DATABASE_URL")
  // Direct (non-pooled) connection used by `prisma migrate` / introspection.
  // On Vercel Postgres this is the *_URL_NON_POOLING / DIRECT_URL value.
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  completed
  in_progress
  archived
}

model Project {
  id                  String         @id @default(cuid())
  titleHe             String
  titleEn             String
  descriptionHe       String
  descriptionEn       String
  shortDescriptionHe  String
  shortDescriptionEn  String
  coverImage          String
  images              String[]       @default([])
  githubUrl           String?
  liveUrl             String?
  tags                String[]
  featured            Boolean        @default(false)
  order               Int            @default(0) @map("sort_order")
  visible             Boolean        @default(true)
  role                String?
  year                Int?
  status              ProjectStatus?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([visible, order])
}
